{
  "name": "krillion-local",
  "version": "1.3.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.local.config.ts --host 127.0.0.1",
    "dev:local": "vite --config vite.local.config.ts --host 127.0.0.1",
    "build": "vite build --config vite.local.config.ts",
    "build:local": "vite build --config vite.local.config.ts",
    "start": "python3 scripts/serve.py",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:hostinger": "node --experimental-strip-types scripts/build-hostinger.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "description": "A local, ad-free rare-answer trivia expedition with unlimited runs.",
  "license": "MIT"
}
